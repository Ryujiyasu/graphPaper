{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "graphPaper",
  "version": "0.1.0",
  "identifier": "io.github.ryujiyasu.graphpaper",
  "build": {
    "beforeBuildCommand": "node scripts/assemble.mjs",
    "beforeDevCommand": "node scripts/assemble.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "graphPaper — 方眼紙専用ソフト", "width": 1360, "height": 900, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "publisher": "graphPaper",
    "category": "Productivity",
    "shortDescription": "方眼紙専用ソフト",
    "longDescription": "Excel 方眼紙を、方眼紙のためだけに作られたソフトで作る。保存すると普通の .xlsx になり、Excel でそのまま開ける。",
    "copyright": "graphPaper contributors, MIT OR Apache-2.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "languages": ["Japanese", "English"], "displayLanguageSelector": false, "installMode": "currentUser" },
      "wix": { "language": ["ja-JP"] }
    }
  }
}
